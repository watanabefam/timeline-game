{
  "name": "timeline-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "No-backend timeline-ordering game with pluggable decks.",
  "scripts": {
    "gen:backlog": "node scripts/gen-pronunciation-backlog.mjs",
    "gen:index": "node scripts/gen-deck-index.mjs",
    "gen:recipe": "node scripts/gen-narration-recipe.mjs",
    "gen:sourcing": "node scripts/gen-sourcing-backlog.mjs",
    "test": "npm --prefix tools/content-pipeline run test && npm --prefix tools/narration run test",
    "validate": "npm run validate:index && npm run validate:content && npm run validate:vendor && npm run validate:recipe && npm run validate:narration && npm run validate:backlog && npm run validate:sourcing && node -e \"console.log('\\u00b7 content-pipeline gate (validate:pipeline) is NOT in this chain: 321 unsourced events, counted in content/sourcing-backlog.json. Run: npm run validate:pipeline')\"",
    "enrich": "node scripts/enrich-cc.mjs && node scripts/enrich-general.mjs && node scripts/geo-fill.mjs && node scripts/validate-content.mjs",
    "enrich:cc": "node scripts/enrich-cc.mjs && node scripts/geo-fill.mjs",
    "enrich:general": "node scripts/enrich-general.mjs && node scripts/geo-fill.mjs",
    "geo": "node scripts/geo-fill.mjs",
    "narration": "node tools/narration/generate.mjs",
    "narration:audit": "node tools/narration/audit.mjs",
    "narration:strips": "node tools/narration/audit.mjs --strips",
    "narration:try": "node tools/narration/strips.mjs",
    "narration:wikipro": "node tools/narration/fetch-wikipro.mjs",
    "narration:worksheet": "node tools/narration/audit.mjs --worksheet",
    "pipeline:brief": "node tools/content-pipeline/brief.mjs",
    "pipeline:fetch": "node tools/content-pipeline/fetch-source.mjs",
    "pipeline:provenance": "node tools/content-pipeline/provenance.mjs",
    "pipeline:review": "node tools/content-pipeline/review.mjs",
    "pipeline:sources": "node tools/content-pipeline/check-sources.mjs",
    "validate:backlog": "node scripts/gen-pronunciation-backlog.mjs --check",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:index": "node scripts/gen-deck-index.mjs --check",
    "validate:narration": "node scripts/validate-narration.mjs",
    "validate:pipeline": "node tools/content-pipeline/verify-all.mjs",
    "validate:recipe": "node scripts/gen-narration-recipe.mjs --check",
    "validate:sourcing": "node scripts/gen-sourcing-backlog.mjs --check",
    "validate:vendor": "node scripts/check-vendored.mjs"
  }
}
